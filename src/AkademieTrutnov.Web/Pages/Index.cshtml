@page
@model IndexModel
@{
    ViewData["Title"] = "Přehled systému";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Informační systém Akademie Trutnov</h2>
        <p class="text-muted mb-0">Evidence kurzů, řízení kapacit, pořadník zájemců a certifikace</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="/Prihlasky" class="btn btn-primary-custom">
            Zapsat studenta
        </a>
        <a asp-page="/Terminy" class="btn btn-outline-secondary">
            Vypsat termín
        </a>
    </div>
</div>

<!-- KPI Karty -->
<div class="kpi-grid">
    <div class="kpi-card blue">
        <div class="kpi-title">Katalog kurzů</div>
        <div class="kpi-value">@Model.CelkemKurzu</div>
        <div class="kpi-desc">Rekvalifikační a odborné kurzy</div>
    </div>
    <div class="kpi-card green">
        <div class="kpi-title">Aktivní termíny</div>
        <div class="kpi-value">@Model.AktivnichTerminu</div>
        <div class="kpi-desc">Probíhající a vypsané běhy</div>
    </div>
    <div class="kpi-card amber">
        <div class="kpi-title">Zájemci v pořadníku</div>
        <div class="kpi-value">@Model.PocetVPoradniku</div>
        <div class="kpi-desc">Čekající náhradníci v pořadí</div>
    </div>
    <div class="kpi-card purple">
        <div class="kpi-title">Vydaná osvědčení</div>
        <div class="kpi-value">@Model.CelkemOsvedceni</div>
        <div class="kpi-desc">Globálně unikátní certifikáty</div>
    </div>
</div>

@if (Model.CekajiciNabidky.Any())
{
    <div class="content-card border-warning mb-4" style="background: #fffdf5;">
        <div class="content-card-header">
            <h5 class="content-card-title text-warning-emphasis">
                ⏳ Aktuální nabídky náhradníkům (Rozhodnutí č. 2: Lhůta 24h na potvrzení)
            </h5>
            <span class="badge badge-nabidnuto">@Model.CekajiciNabidky.Count nabídka k vyřešení</span>
        </div>
        <p class="text-muted small">
            Při uvolnění místa systém automaticky nabídl účast prvnímu v pořadníku. Pokud zájemce nepotvrdí do vypršení lhůty, systém nabídne místo dalšímu.
        </p>
        <div class="table-responsive">
            <table class="table table-custom">
                <thead>
                    <tr>
                        <th>Student</th>
                        <th>Termín / Kurz</th>
                        <th>Čas vypršení (Hold)</th>
                        <th>Zbývající čas</th>
                        <th>Akce</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var n in Model.CekajiciNabidky)
                    {
                        var timeLeft = (n.NabidkaExpirace ?? DateTime.UtcNow) - DateTime.UtcNow;
                        <tr>
                            <td>
                                <strong>@(n.Student?.CeleJmeno ?? "Student")</strong><br />
                                <small class="text-muted">@(n.Student?.Email ?? "")</small>
                            </td>
                            <td>@(n.Termin?.Kurz?.Nazev ?? "Kurz")</td>
                            <td>@(n.NabidkaExpirace?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "-")</td>
                            <td>
                                @if (timeLeft.TotalMinutes > 0)
                                {
                                    <span class="badge bg-warning text-dark">zbývá @Math.Max(0, (int)timeLeft.TotalHours) h @(timeLeft.Minutes) min</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Vypršelo</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex gap-2">
                                    <form method="post" asp-page-handler="AcceptOffer" class="d-inline">
                                        <input type="hidden" name="prihlaskaId" value="@n.Id" />
                                        <button type="submit" class="btn btn-sm btn-success">Potvrdit účast</button>
                                    </form>
                                    <form method="post" asp-page-handler="DeclineOffer" class="d-inline">
                                        <input type="hidden" name="prihlaskaId" value="@n.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Odmítnout</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Tabulka aktivních termínů a naplněnosti -->
<div class="content-card">
    <div class="content-card-header">
        <h5 class="content-card-title">📅 Přehled aktivních termínů a vytížení</h5>
        <a asp-page="/Terminy" class="btn btn-sm btn-outline-primary">Zobrazit všechny termíny</a>
    </div>

    <div class="table-responsive">
        <table class="table table-custom">
            <thead>
                <tr>
                    <th>Kurz</th>
                    <th>Termín & Místo</th>
                    <th>Obsazenost / Kapacita</th>
                    <th>Vytíženost</th>
                    <th>Pořadník</th>
                    <th>Stav</th>
                    <th>Akce</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model.AktivniTerminy)
                {
                    int prihlaseni = t.Prihlasky.Count(p => p.Stav == StavPrihlasky.Prihlasen || p.Stav == StavPrihlasky.Dokonceno);
                    int nabidnuto = t.Prihlasky.Count(p => p.Stav == StavPrihlasky.Nabidnuto);
                    int poradnik = t.Prihlasky.Count(p => p.Stav == StavPrihlasky.Poradnik);
                    int obsazeno = prihlaseni + nabidnuto;
                    double pct = t.Kapacita > 0 ? ((double)obsazeno / t.Kapacita) * 100.0 : 0;
                    string barColor = pct >= 100 ? "red" : (pct >= 80 ? "amber" : "green");

                    <tr>
                        <td>
                            <strong>@(t.Kurz?.Nazev ?? "Kurz")</strong><br />
                            <small class="text-muted">@(t.Kurz?.RozsahHodin ?? 0) hodin @(t.Kurz?.Akreditovano == true ? "| Akreditováno MŠMT" : "")</small>
                        </td>
                        <td>
                            @t.DatumOd.ToString("dd.MM.yyyy") – @t.DatumDo.ToString("dd.MM.yyyy")<br />
                            <small class="text-muted">🏢 @(t.Ucebna?.Nazev ?? "Učebna")</small>
                        </td>
                        <td>
                            <strong>@obsazeno / @t.Kapacita míst</strong>
                            @if (nabidnuto > 0)
                            {
                                <span class="badge badge-nabidnuto ms-1">@nabidnuto v nabídce</span>
                            }
                            <div class="capacity-progress">
                                <div class="capacity-progress-bar @barColor" style="width: @Math.Min(100, pct)%"></div>
                            </div>
                        </td>
                        <td>
                            <span class="fw-semibold">@Math.Round(pct, 0)%</span>
                        </td>
                        <td>
                            @if (poradnik > 0)
                            {
                                <span class="badge badge-poradnik">@poradnik náhradníků</span>
                            }
                            else
                            {
                                <span class="text-muted small">Žádní náhradníci</span>
                            }
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">@t.Stav</span>
                        </td>
                        <td>
                            <div class="d-flex gap-1">
                                <a asp-page="/Prihlasky" asp-route-terminId="@t.Id" class="btn btn-sm btn-outline-primary">Přihlášky</a>
                                <a asp-page="/Dochazka" asp-route-terminId="@t.Id" class="btn btn-sm btn-outline-secondary">Docházka</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
